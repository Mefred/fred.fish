---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
const collections = [
  { number:"01", title:"Switching fundamentals", level:"FOUNDATION", description:"Inspect switch operation, learn MAC address-table behavior, and configure access ports.", topics:["MAC address learning","Access-port configuration","Interface verification"], state:"Planned" },
  { number:"02", title:"VLANs and 802.1Q trunks", level:"NETWORK ACCESS", description:"Segment a small LAN, configure VLAN membership, establish a trunk, and diagnose common mismatches.", topics:["VLAN creation and assignment","802.1Q trunking","Native and allowed VLANs"], state:"Planned" },
  { number:"03", title:"Inter-VLAN routing", level:"IP CONNECTIVITY", description:"Connect multiple VLANs using router-on-a-stick, then verify gateway and end-to-end reachability.", topics:["802.1Q subinterfaces","Default gateways","Routing verification"], state:"Planned" },
  { number:"04", title:"Static routing and troubleshooting", level:"IP CONNECTIVITY", description:"Connect separate IP networks with static routes and use a repeatable process to isolate failures.", topics:["Static and default routes","Routing-table inspection","Ping and traceroute"], state:"Planned" },
];
---
<SiteLayout title="Cisco Labs — fred.fish" description="Practical Cisco networking lab scenarios and guided configuration exercises." active="cisco">
  <div class="workspace-page">
    <div class="workspace-breadcrumb"><a href="/">fred.fish</a><span>/</span><a href="/cisco/">cisco</a><span>/</span><strong>labs</strong></div>
    <header class="workspace-hero">
      <Eyebrow index="02" label="CISCO / HANDS-ON PRACTICE" />
      <h1>Build it.<br /><span>Break it. Understand it.</span></h1>
      <p>Practical exercises designed to turn protocol knowledge into repeatable configuration and troubleshooting skills. Each lab is structured around a clear outcome, not just a list of commands.</p>
    </header>
    <section class="lab-method">
      <div><Eyebrow label="LAB STANDARD" /><h2>Every lab should be verifiable.</h2></div>
      <p>Guided labs are being developed with objectives, prerequisites, topology and addressing, tasks, expected command output, verification steps, and troubleshooting prompts. Platform-specific differences will be called out rather than hidden.</p>
    </section>
    <div class="workspace-section-heading"><div><Eyebrow label="LEARNING PATH" /><h2>Lab collections</h2></div><span>4 STARTER SCENARIOS</span></div>
    <div class="lab-grid">
      {collections.map((lab) => <article class="lab-card">
        <div class="lab-card-top"><span>{lab.number}</span><span class="lab-level">{lab.level}</span></div>
        <h3>{lab.title}</h3><p>{lab.description}</p>
        <ul>{lab.topics.map((topic) => <li>{topic}</li>)}</ul>
        <div class="lab-card-footer"><span class="lab-status">{lab.state}</span><span>Content in development</span></div>
      </article>)}
    </div>
    <section class="lab-environments">
      <Eyebrow label="SUPPORTED ENVIRONMENTS" />
      <div class="environment-grid">
        <div><h3>Packet Tracer</h3><p>Useful for guided topologies, repeatable introductory exercises, and visualizing packet flow.</p></div>
        <div><h3>Physical equipment</h3><p>IOS XE examples will document hardware assumptions and note where commands or features vary by platform.</p></div>
        <div><h3>Virtual network labs</h3><p>Where appropriate, exercises can include notes for virtualized network devices and their setup requirements.</p></div>
      </div>
    </section>
    <div class="workspace-next"><span>Want to study the concepts first?</span><a href="/cisco/learning/">Return to the curriculum ↗</a></div>
  </div>
</SiteLayout>
