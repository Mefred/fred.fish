---
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import Eyebrow from "../../../../components/Eyebrow.astro";
const modules = [
  ["01","Networking Today","Network roles, topologies, LANs and WANs, Internet access, network reliability, trends, and security.","/cisco/learning/semester-1/modules/01-networking-today/","block-0004","Source lesson rebuilt"],
  ["02","Basic Switch and End Device Configuration","Cisco IOS access, command modes, device configuration, management addressing, and connectivity verification.","/cisco/learning/semester-1/modules/02-basic-device-configuration/","IMG-0144","Source lesson rebuilt"],
  ["03","Protocols and Models","Protocol rules, protocol suites, standards organizations, OSI and TCP/IP models, encapsulation, and data access.","/cisco/learning/semester-1/modules/03-protocols-and-models/","IMG-0218","Source lesson rebuilt"],
  ["04","Physical Layer","Physical-layer purpose, signals, bandwidth, copper cabling, fiber-optic cabling, and wireless media.","/cisco/learning/semester-1/modules/04-physical-layer/","IMG-0371","Source lesson rebuilt"],
  ["05","Number Systems","Binary and hexadecimal number systems, conversions, and their use in network addressing.","/cisco/learning/semester-1/modules/05-number-systems/","IMG-0390","Source lesson rebuilt"],
  ["06","Data Link Layer","Layer 2 purpose, framing, topologies, media access, and the LLC and MAC sublayers.","/cisco/learning/semester-1/modules/06-data-link-layer/","IMG-0424","Source lesson rebuilt"],
  ["07","Ethernet Switching","Ethernet frames and MAC addresses, MAC address tables, switching methods, and switch forwarding.","/cisco/learning/semester-1/modules/07-ethernet-switching/","IMG-0478","Source lesson rebuilt"],
  ["08","Network Layer","IPv4 and IPv6 packets, network-layer characteristics, host routing, and router routing tables.","/cisco/learning/semester-1/modules/08-network-layer/","IMG-0641","Source lesson rebuilt"],
  ["09","Address Resolution","IPv4 ARP tables and requests, IPv6 Neighbor Discovery, and ICMPv6 messages.","/cisco/learning/semester-1/modules/09-address-resolution/","IMG-0660","Source lesson rebuilt"],
  ["10","Basic Router Configuration","Initial router settings, interface configuration, default gateways, and connectivity verification.","/cisco/learning/semester-1/modules/10-basic-router-configuration/","IMG-0738","Source lesson rebuilt"],
  ["11","IPv4 Addressing","IPv4 structure, unicast/broadcast/multicast, public/private addresses, subnetting, VLSM, and address planning.","/cisco/learning/semester-1/modules/11-ipv4-addressing/","IMG-0888","Source lesson rebuilt"],
  ["12","IPv6 Addressing","IPv6 notation, address types, GUAs and LLAs, static and dynamic addressing, SLAAC, and subnetting.","/cisco/learning/semester-1/modules/12-ipv6-addressing/","IMG-0969","Source lesson rebuilt"],
  ["13","ICMP","ICMP and ICMPv6 messages, ping, traceroute, and connectivity testing.","/cisco/learning/semester-1/modules/13-icmp/","IMG-1123","Source lesson rebuilt"],
  ["14","Transport Layer","TCP and UDP, port numbers, reliability, flow control, and transport communication.","/cisco/learning/semester-1/modules/14-transport-layer/","IMG-1168","Source lesson rebuilt"],
  ["15","Application Layer","Application protocols, web and email protocols, IP addressing services, and file-sharing services.","/cisco/learning/semester-1/modules/15-application-layer/","IMG-1263","Source lesson rebuilt"],
  ["16","Network Security Fundamentals","Threat actors, malware, network attacks, device security, secure management, and defense in depth.","/cisco/learning/semester-1/modules/16-network-security/","IMG-1510","Source lesson rebuilt"],
  ["17","Build a Small Network","Small-network devices and applications, scaling, host and IOS commands, and troubleshooting methodology.","/cisco/learning/semester-1/modules/17-build-small-network/","IMG-1449","Source lesson rebuilt"]
];
---
<SiteLayout title="Semester 1 Networking Course — fred.fish" description="A source-traceable Semester 1 networking course reconstructed from lecture notes, screenshots, and diagrams." active="cisco">
  <section class="semester-index">
    <div class="semester-nav"><a href="/cisco/learning/">← All learning modules</a><div><a href="/cisco/practice/">Adaptive practice ↗</a><a href="/cisco/progress/">Progress ↗</a></div></div>
    <header class="semester-hero"><Eyebrow index="S1 / COURSE" label="SEMESTER 1 / INTRODUCTION TO NETWORKS" /><h1>Networking, from<br /><span>the fundamentals up.</span></h1><p>This course follows the 17-module Cisco Introduction to Networks sequence found in the lecture material. The course was reconstructed from the recovered OneNote text and its 2,646 image assets. Lessons cite the relevant source blocks and screenshots; diagram-dependent details and OCR-derived answer keys remain subject to visual verification.</p><div class="semester-tags"><span>17 SOURCE MODULES</span><span>2,646 IMAGE ASSETS OCR-INDEXED</span><span>611 PRACTICE QUESTIONS · 610 CONCEPT TAGS</span></div></header>
    <section class="source-notice"><strong>How source coverage is represented</strong><p>All 17 modules have dedicated lesson routes with source references. The depth of source-specific reconstruction varies by module: some topics are supported by recovered text blocks, while others rely more heavily on screenshots and diagrams. A source reference documents provenance; it does not by itself mean every visual detail has been independently verified.</p></section>
    <div class="module-grid">
      {modules.map((module)=><article class="module-card"><div class="module-card-top"><span>{module[0]}</span><code>{module[4]}</code></div><h2>{module[1]}</h2><p>{module[2]}</p><div class="module-card-foot"><small>{module[5]}</small><a href={module[3]}>Open lesson ↗</a></div></article>)}
    </div>
    <section class="semester-footer"><div><Eyebrow label="PRACTICE AND RETENTION" /><h2>Practice across the concepts.</h2><p>Short sessions adapt to your strengths, weak areas, and concepts due for review.</p></div><a class="semester-button" href="/cisco/practice/">Start a practice session →</a></section>
  </section>
</SiteLayout>
<style>
.semester-index{max-width:1120px;margin:auto;padding:45px 24px 100px}.semester-nav{display:flex;justify-content:space-between;color:var(--muted);font:11px "DM Mono",monospace}.semester-nav>div{display:flex;gap:18px}.semester-nav a:hover{color:var(--teal)}.semester-hero{padding:70px 0 34px}.semester-hero h1{font-size:clamp(42px,6vw,70px);line-height:1.03;letter-spacing:-.075em;margin:20px 0}.semester-hero h1 span{color:var(--teal)}.semester-hero p{max-width:700px;color:var(--muted);line-height:1.85}.semester-tags{display:flex;gap:20px;flex-wrap:wrap;margin-top:25px;color:var(--subtle);font:9px "DM Mono",monospace;letter-spacing:.08em}.source-notice{padding:18px 20px;border:1px solid var(--line);border-left:3px solid var(--teal);border-radius:10px;background:var(--surface)}.source-notice p{margin:5px 0 0;color:var(--muted);font-size:13px}.module-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin-top:30px}.module-card{display:flex;flex-direction:column;padding:20px;border:1px solid var(--line);border-radius:13px;background:linear-gradient(145deg,#10212a,#0b151d);min-height:205px}.module-card-top{display:flex;justify-content:space-between;color:var(--teal);font:11px "DM Mono",monospace}.module-card-top code{color:var(--subtle);font-size:9px}.module-card h2{font-size:19px;letter-spacing:-.035em;margin:17px 0 8px}.module-card p{font-size:12px;color:var(--muted);line-height:1.7;margin:0 0 18px}.module-card-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:auto;padding-top:12px;border-top:1px solid var(--line-soft)}.module-card-foot small{font:9px "DM Mono",monospace;color:var(--subtle)}.module-card-foot a{font-size:11px;color:var(--teal);white-space:nowrap}.semester-footer{margin-top:48px;padding:28px;border:1px solid var(--line);border-radius:15px;display:flex;align-items:center;justify-content:space-between;gap:20px;background:linear-gradient(140deg,#10262b,#0c171e)}.semester-footer h2{font-size:25px;margin:8px 0}.semester-footer p{margin:0;color:var(--muted);font-size:13px}.semester-button{white-space:nowrap;background:var(--teal);color:#061513;padding:12px 16px;border-radius:8px;font-size:12px;font-weight:750}@media(max-width:700px){.semester-index{padding:28px 18px 70px}.semester-hero{padding:48px 0 28px}.module-grid{grid-template-columns:1fr}.semester-footer{align-items:flex-start;flex-direction:column}.semester-nav{gap:12px;align-items:flex-start;flex-direction:column}}
</style>