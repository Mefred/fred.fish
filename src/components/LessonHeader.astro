---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  metadata: string[];
}
const { eyebrow, title, lead, metadata } = Astro.props;
---
<header class="lesson-header" data-lesson-header>
  <div class="eyebrow">{eyebrow}</div>
  <h1>{title}</h1>
  <p class="page-lead">{lead}</p>
  <div class="lesson-meta">
    {metadata.map((item) => <span>{item}</span>)}
  </div>
</header>
