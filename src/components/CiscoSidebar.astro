---
/** Shared navigation shell for Cisco lesson pages. Keep the class hooks stable for site.js. */
---
<button class="mobile-menu" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">☰</button>
<aside class="sidebar" id="sidebar">
  <a class="wordmark" href="/"><span class="wordmark-icon">f.</span><span>fred.fish</span></a>
  <div class="tree-label">WORKSPACE</div>
  <nav class="file-tree" aria-label="Site navigation">
    <a class="tree-row" href="/"><span class="file-icon">⌂</span><span>home</span></a>
    <button class="tree-row folder-toggle" type="button" aria-expanded="true" aria-controls="cisco-links"><span class="chevron">▾</span><span class="folder-icon">▰</span><span class="folder-name">cisco/</span></button>
    <div class="tree-children" id="cisco-links">
      <a class="tree-row child" href="/cisco/"><span class="file-icon">◫</span><span>overview</span></a>
      <a class="tree-row child active" href="/cisco/learning/" aria-current="page"><span class="file-icon">◫</span><span>learning</span></a>
      <a class="tree-row child" href="/cisco/labs/"><span class="file-icon">◫</span><span>labs</span></a>
      <a class="tree-row child" href="/cisco/reference/"><span class="file-icon">◫</span><span>reference</span></a>
    </div>
    <button class="tree-row folder-toggle" type="button" aria-expanded="true" aria-controls="reef-links"><span class="chevron">▾</span><span class="folder-icon">▰</span><span class="folder-name">reef/</span></button>
    <div class="tree-children" id="reef-links"><a class="tree-row child" href="/reef/"><span class="file-icon">◫</span><span>overview</span></a></div>
  </nav>
  <div class="sidebar-bottom"><span class="status-dot"></span><span>A little corner of the internet</span></div>
  <button class="sidebar-collapse" type="button" aria-expanded="true"><span class="collapse-icon">⇤</span><span class="collapse-label">Collapse sidebar</span></button>
</aside>
<div class="sidebar-backdrop" hidden></div>
